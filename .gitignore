# ---- never commit -------------------------------------------------------
# Database credentials + application key. Created on the server by
# admin/install.php (or by copying config.db.sample.php).
/config.db.php
/config.local.php

# ---- runtime / generated ------------------------------------------------
# The folders still have to EXIST after a fresh clone (Hostinger Git deploys
# into an empty directory), so their .gitkeep is tracked and only the contents
# are ignored. Everything in them is recreated on demand.
/data/cache/*
!/data/cache/.gitkeep
/data/backups/*
!/data/backups/.gitkeep
/data/engagement/*.json.tmp
/uploads/media/*
!/uploads/media/.gitkeep
*.log
.DS_Store
Thumbs.db

# ---- local tooling ------------------------------------------------------
/node_modules/
/vendor/
/.venv/
__pycache__/
*.pyc
.idea/
.vscode/
